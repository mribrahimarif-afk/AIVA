// AIVA Studio - Prisma schema (TASK-001 foundation)
//
// Status/type fields are modeled as String rather than native Prisma enums
// because the SQLite connector does not support enum columns. The
// authoritative set of allowed values lives in TypeScript/Zod under
// src/domain, and Prisma stores whatever those layers validate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  script      String   @default("")
  status      String   @default("DRAFT")
  aspectRatio String   @default("9:16")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenes       Scene[]
  assets       Asset[]
  directorPlan DirectorPlan?
  voiceTrack   VoiceTrack?
  audioSources AudioSource[]
  transcriptions Transcription[]

  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  assets   Asset[]

  @@index([name])
  @@map("brands")
}

model Product {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  aliases ProductAlias[]
  assets  Asset[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([name])
  @@map("products")
}

model ProductAlias {
  id              String   @id @default(cuid())
  productId       String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedAlias])
  @@index([productId])
  @@index([normalizedAlias])
  @@map("product_aliases")
}

model ContentBlob {
  id          String   @id @default(cuid())
  checksum    String   @unique
  storagePath String
  sizeBytes   Int
  mimeType    String
  createdAt   DateTime @default(now())

  assets Asset[]

  @@index([checksum])
  @@map("content_blobs")
}

model Scene {
  id        String   @id @default(cuid())
  projectId String
  sequence  Int
  text      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequence])
  @@index([projectId])
  @@index([status])
  @@map("scenes")
}

model Asset {
  id               String   @id @default(cuid())
  title            String?
  originalFilename String?
  type             String
  vaultRole        String?
  source           String
  localPath        String?
  mimeType         String?
  sizeBytes        Int?
  checksum         String?
  metadata         String?
  createdAt        DateTime @default(now())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  blobId String?
  blob   ContentBlob? @relation(fields: [blobId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([brandId])
  @@index([productId])
  @@index([blobId])
  @@index([vaultRole])
  @@index([checksum])
  @@index([type])
  @@index([source])
  @@map("assets")
}

model DirectorPlan {
  id                String   @id @default(cuid())
  projectId         String   @unique
  originalScript    String
  scriptHash        String
  unitizerVersion   String
  schemaVersion     String
  promptVersion     String
  model             String
  language          String
  contentType       String
  summary           String
  creativeDirection String
  brandId               String?
  productId             String?
  sourceType            String   @default("SCRIPT")
  sourceTranscriptionId String?
  sourceAudioHash       String?
  generatedAt           DateTime @default(now())

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes            DirectorScene[]
  voiceTracks       VoiceTrack[]

  @@index([projectId])
  @@index([scriptHash])
  @@index([sourceType])
  @@index([sourceTranscriptionId])
  @@map("director_plans")
}

model DirectorScene {
  id               String   @id @default(cuid())
  directorPlanId   String
  order            Int
  text             String
  unitIds          String   // JSON stringified array of unit IDs
  purpose          String
  visualBrief      String
  visualSourceHint String
  shotType         String
  mood             String
  setting          String
  subject          String
  productPresence  String
  searchQuery      String
  keywords         String   // JSON stringified array of keywords
  manualAiPrompt   String?
  sourceSpanStart  Int
  sourceSpanEnd    Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  directorPlan     DirectorPlan @relation(fields: [directorPlanId], references: [id], onDelete: Cascade)

  @@unique([directorPlanId, order])
  @@index([directorPlanId])
  @@map("director_scenes")
}

model VoiceTrack {
  id               String   @id @default(cuid())
  projectId        String   @unique
  directorPlanId   String
  sourceScriptHash String
  provider         String   @default("azure-speech")
  model            String   @default("azure-neural")
  voiceName        String
  locale           String
  outputFormat     String
  audioSha256      String
  audioByteCount   Int
  audioStorageRef  String
  durationMs       Int
  generatedAt      DateTime @default(now())

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  directorPlan     DirectorPlan    @relation(fields: [directorPlanId], references: [id], onDelete: Cascade)
  boundaries       VoiceBoundary[]

  @@index([projectId])
  @@index([directorPlanId])
  @@index([sourceScriptHash])
  @@map("voice_tracks")
}

model VoiceBoundary {
  id              String   @id @default(cuid())
  voiceTrackId    String
  order           Int
  sourceStart     Int
  sourceEnd       Int
  audioStartMs    Int
  audioDurationMs Int

  voiceTrack      VoiceTrack @relation(fields: [voiceTrackId], references: [id], onDelete: Cascade)

  @@unique([voiceTrackId, order])
  @@index([voiceTrackId])
  @@map("voice_boundaries")
}

model AudioSource {
  id                    String   @id @default(cuid())
  projectId             String
  storageRef            String
  sourceHash            String
  mimeType              String
  sizeBytes             Int
  durationMs            Int?
  originalDisplayName   String?
  activeTranscriptionId String?
  createdAt             DateTime @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcriptions Transcription[]

  @@index([projectId])
  @@index([sourceHash])
  @@map("audio_sources")
}

model Transcription {
  id                String   @id @default(cuid())
  projectId         String
  audioSourceId     String
  provider          String
  model             String
  requestedMode     String
  displayText       String
  canonicalText     String
  detectedLanguage  String?
  durationMs        Int
  wordCount         Int
  sourceAudioHash   String
  configurationHash String
  createdAt         DateTime @default(now())

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audioSource AudioSource         @relation(fields: [audioSourceId], references: [id], onDelete: Cascade)
  words       TranscriptionWord[]

  @@index([projectId])
  @@index([audioSourceId])
  @@index([sourceAudioHash])
  @@index([configurationHash])
  @@map("transcriptions")
}

model TranscriptionWord {
  id              String   @id @default(cuid())
  transcriptionId String
  sequence        Int
  text            String
  startMs         Int
  endMs           Int
  sourceStart     Int
  sourceEnd       Int
  speaker         String?
  confidence      Float?
  locale          String?

  transcription Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@unique([transcriptionId, sequence])
  @@index([transcriptionId])
  @@map("transcription_words")
}


