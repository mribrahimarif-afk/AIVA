# AIVA Studio - environment configuration
# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

# --- Database -----------------------------------------------------------
# SQLite database file, resolved relative to the Prisma schema directory (prisma/).
# "file:./dev.db" resolves to "<repo>/prisma/dev.db".
DATABASE_URL="file:./dev.db"

# --- Storage --------------------------------------------------------------
# Root directory for all AIVA-managed files (projects, brands, assets, cache).
# May be absolute or relative to the project root. No machine-specific
# defaults are baked into the app; if unset it falls back to "./storage".
AIVA_STORAGE_ROOT="./storage"

# Maximum upload payload size in bytes for Vault uploads (default: 524288000 = 500 MB).
AIVA_MAX_UPLOAD_BYTES=524288000

# --- FFmpeg ---------------------------------------------------------------
# Optional explicit path to an ffmpeg binary. If unset, AIVA looks for
# "ffmpeg" on the system PATH. Rendering is not implemented in this task;
# this is used for health/detection reporting only.
AIVA_FFMPEG_PATH=""

# --- Application defaults --------------------------------------------------
# One of: 9:16 | 16:9 | 1:1
AIVA_DEFAULT_ASPECT_RATIO="9:16"

# One of: debug | info | warn | error
AIVA_LOG_LEVEL="info"

# --- Provider configuration ------------------------------------------------
# Gemini API key is server-only. If unset, Director reports an unconfigured state.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_TIMEOUT_MS=45000
DIRECTOR_MAX_SCRIPT_CHARS=50000

# Other provider placeholders (TASK-001/TASK-002/TASK-003 do not use these)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
