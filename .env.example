# AIVA Studio - environment configuration
# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

# --- Database -----------------------------------------------------------
# SQLite database file, resolved relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# --- Storage --------------------------------------------------------------
# Root directory for all AIVA-managed files (projects, brands, assets, cache).
# May be absolute or relative to the project root. No machine-specific
# defaults are baked into the app; if unset it falls back to "./storage".
AIVA_STORAGE_ROOT="./storage"

# --- FFmpeg ---------------------------------------------------------------
# Optional explicit path to an ffmpeg binary. If unset, AIVA looks for
# "ffmpeg" on the system PATH. Rendering is not implemented in this task;
# this is used for health/detection reporting only.
AIVA_FFMPEG_PATH=""

# --- Application defaults --------------------------------------------------
# One of: 9:16 | 16:9 | 1:1
AIVA_DEFAULT_ASPECT_RATIO="9:16"

# One of: debug | info | warn | error
AIVA_LOG_LEVEL="info"

# --- Provider configuration (placeholders only, TASK-001 does not use these) -
# Presence/absence is used purely to report configuration status in Settings.
GEMINI_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
